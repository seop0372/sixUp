# Anthropic API 키 (console.anthropic.com 에서 발급)
ANTHROPIC_API_KEY=여기에_본인_API_키_입력

# 서버 포트 (안 바꿔도 됨)
PORT=3000

# 로그인 세션 쿠키 서명에 쓰는 비밀 값 (아무 랜덤 문자열이나 넣으면 됨)
SESSION_SECRET=여기에_랜덤한_문자열_입력

# 카카오 로그인 (Kakao Developers > 내 애플리케이션 > 앱 키 > REST API 키)
KAKAO_REST_API_KEY=여기에_카카오_REST_API_키_입력
# Kakao Developers > 카카오 로그인 > Redirect URI 에 등록한 값과 정확히 같아야 함
KAKAO_REDIRECT_URI=http://localhost:3000/api/auth/kakao/callback
